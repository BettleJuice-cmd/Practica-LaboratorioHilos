
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.uam.edu.practicalaboratoriohilos.controller.ProcesadorController"
      alignment="CENTER"
      spacing="12"
      style="-fx-padding: 20;">

    <Label text="Procesamiento concurrente"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <Label fx:id="lblEstado"
           text="Estado: En espera"/>

    <Label fx:id="lblContador"
           text="Solicitudes procesadas: 0"/>

    <HBox alignment="CENTER" spacing="10">

        <Button fx:id="btnIniciar"
                text="Iniciar"
                onAction="#iniciarProcesamiento"/>

        <Button fx:id="btnDetener"
                text="Detener"
                disable="true"
                onAction="#detenerProcesamiento"/>

    </HBox>

    <Label text="Registro de operaciones"/>

    <TextArea fx:id="txtRegistro"
              editable="false"
              prefHeight="180"/>

</VBox>

