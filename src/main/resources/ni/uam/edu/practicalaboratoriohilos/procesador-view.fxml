<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="0.0" style="-fx-background-color: #0b1f36;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.practicalaboratoriohilos.controller.ProcesadorController">

    <!-- Franja superior con el tono de naranja exacto (#DF5800) -->
    <HBox alignment="CENTER" style="-fx-background-color: #DF5800; -fx-padding: 15px;">
        <Label text="Gestión de Procesamiento y Hilos" textFill="WHITE">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
    </HBox>

    <!-- Contenedor inferior -->
    <VBox alignment="CENTER" prefHeight="283.0" prefWidth="346.0" spacing="15.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>

        <HBox alignment="CENTER" prefHeight="72.0" prefWidth="306.0" spacing="10.0">
            <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#iniciarProcesamiento" prefWidth="72.0" style="-fx-background-color: #2088b2; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-padding: 8px 18px;" text="Iniciar" />
            <Button fx:id="btnDetener" mnemonicParsing="false" onAction="#detenerProcesamiento" prefWidth="92.0" style="-fx-background-color: #DF5800; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6px; -fx-font-weight: bold; -fx-padding: 8px 18px;" text="Detener" />
        </HBox>

        <VBox spacing="5.0">
            <Label fx:id="lblContador" text="Contador: 0" textFill="#9bc4e2">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label fx:id="lblEstado" text="Estado: En espera" textFill="#9bc4e2" />
        </VBox>

        <TextArea fx:id="txtRegistro" editable="false" prefHeight="150.0" prefWidth="300.0" promptText="Registro de eventos..." style="-fx-control-inner-background: #071324; -fx-text-fill: #9bc4e2; -fx-background-radius: 6px;" />
    </VBox>
</VBox>
