<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="ni.uam.edu.practicalaboratoriohilos.ProcesadorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Gestión Concurrente de Ventanillas" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#handleIniciar" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Iniciar Procesos" />
        <Button fx:id="btnDetener" mnemonicParsing="false" onAction="#handleDetener" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Detener" />
    </HBox>

    <VBox spacing="5.0">
        <Label fx:id="lblEstadoVentanillaA" text="Ventanilla A: En espera" />
        <Label fx:id="lblEstadoVentanillaB" text="Ventanilla B: En espera" />
        <Label fx:id="lblContador" text="Total Operaciones: 0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font></Label>
    </VBox>

    <TextArea fx:id="txtAreaLog" editable="false" prefHeight="150.0" prefWidth="300.0" promptText="Registro de eventos del sistema..." />
</VBox>